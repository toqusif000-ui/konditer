{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/Button/**",
              "components/general/Card/**",
              "components/general/CardAction/**",
              "components/general/CardContent/**",
              "components/general/CardDescription/**",
              "components/general/CardFooter/**",
              "components/general/CardHeader/**",
              "components/general/CardTitle/**",
              "components/general/Input/**",
              "components/general/Label/**",
              "components/landing/Badge/**",
              "components/landing/CtaLink/**",
              "components/landing/MatCard/**",
              "components/landing/Section/**",
              "components/landing/SectionHeading/**",
              "components/landing/Tag/**",
              "components/lms/Chip/**",
              "components/lms/OrderMark/**",
              "components/lms/PageHeader/**",
              "components/lms/Panel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Manrope|Cormorant Garamond Fallback|Manrope Fallback))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Manrope, Cormorant Garamond Fallback, Manrope Fallback."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:focusableWhenDisabled|nativeButton|ref|id|children|className|render|style|variant|size|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: focusableWhenDisabled, nativeButton, ref, id, children, className, render, style, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:link|default|outline|secondary|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'link' | 'default' | 'outline' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|xs|sm|lg|icon|icon-xs|icon-sm|icon-lg)$/]",
        "message": "<Button> size must be one of 'default' | 'xs' | 'sm' | 'lg' | 'icon' | 'icon-xs' | 'icon-sm' | 'icon-lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|size|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: ref, className, id, style, children, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm)$/]",
        "message": "<Card> size must be one of 'default' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardAction> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardContent'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardContent> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardDescription'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardDescription> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardFooter> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardHeader> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardTitle> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|tone|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, className, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:tint|quiet)$/]",
        "message": "<Chip> tone must be one of 'tint' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|className|tone|key|ref|className|style|children)$/]",
        "message": "<CtaLink> doesn't accept that prop. Declared props: href, children, className, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|white)$/]",
        "message": "<CtaLink> tone must be one of 'accent' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|placeholder|value|defaultValue|name|id|disabled|required|readOnly|autoComplete|autoFocus|maxLength|minLength|pattern|inputMode|onChange|onBlur|onFocus|className|style|ref|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: type, placeholder, value, defaultValue, name, id, disabled, required, readOnly, autoComplete, autoFocus, maxLength, minLength, pattern, inputMode, onChange, onBlur, onFocus, className, style, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='inputMode'] > Literal[value!=/^(?:none|text|tel|url|email|numeric|decimal|search)$/]",
        "message": "<Input> inputMode must be one of 'none' | 'text' | 'tel' | 'url' | 'email' | 'numeric' | 'decimal' | 'search'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:htmlFor|children|id|className|style|ref|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: htmlFor, children, id, className, style, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|innerClassName|key|ref|className|style|children)$/]",
        "message": "<MatCard> doesn't accept that prop. Declared props: children, className, innerClassName."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrderMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|className|key|ref|className|style|children)$/]",
        "message": "<OrderMark> doesn't accept that prop. Declared props: n, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:meta|title|description|className|children|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: meta, title, description, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|id|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: children, className, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|accent|subtitle|badge|variant|className|children|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: title, accent, subtitle, badge, variant, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pill|inline)$/]",
        "message": "<SectionHeading> variant must be one of 'pill' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
